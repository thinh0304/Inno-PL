{
  "key": "contract",
  "name": "Hợp đồng",
  "icon": "file",
  "accent": "slate",
  "description": "Hợp đồng của đơn: khách hàng và từng nhà cung cấp, bản dự thảo và bản chính thức (FR-7.1). Mỗi lần tải lên là một phiên bản mới; không ai sửa hay xóa.",
  "fields": [
    {
      "key": "order",
      "label": "Đơn hàng",
      "type": "reference",
      "target_entity_id": "${entity:order}",
      "required": true,
      "on_target_delete": "cascade",
      "inverse_key": "contracts",
      "inverse_label": "Hợp đồng"
    },
    {
      "key": "party",
      "label": "Bên",
      "type": "enum",
      "required": true,
      "facetable": true,
      "enum_values": [
        {
          "value": "customer",
          "label": "Khách hàng",
          "color": "sky"
        },
        {
          "value": "supplier",
          "label": "Nhà cung cấp",
          "color": "violet"
        }
      ]
    },
    {
      "key": "supplier",
      "label": "Nhà cung cấp",
      "type": "reference",
      "target_entity_id": "${entity:supplier}",
      "on_target_delete": "restrict"
    },
    {
      "key": "step",
      "label": "Bước",
      "type": "enum",
      "required": true,
      "facetable": true,
      "enum_values": [
        {
          "value": "draft",
          "label": "Dự thảo",
          "color": "amber"
        },
        {
          "value": "final",
          "label": "Bản chính thức",
          "color": "emerald"
        }
      ]
    },
    {
      "key": "file",
      "label": "File",
      "type": "file"
    },
    {
      "key": "uploaded_by",
      "label": "Người tải lên",
      "type": "reference",
      "target_entity_id": "ffffffff-0000-0000-0000-000000000001"
    },
    {
      "key": "uploaded_at",
      "label": "Lúc tải lên",
      "type": "datetime"
    },
    {
      "key": "source",
      "label": "Nguồn",
      "type": "enum",
      "facetable": true,
      "default": {
        "kind": "literal",
        "value": "upload"
      },
      "enum_values": [
        {
          "value": "upload",
          "label": "Tải lên"
        },
        {
          "value": "template",
          "label": "Từ mẫu"
        },
        {
          "value": "ai",
          "label": "AI soạn"
        }
      ]
    },
    {
      "key": "value",
      "label": "Giá trị hợp đồng",
      "type": "number"
    },
    {
      "key": "advance_percent",
      "label": "Tỷ lệ tạm ứng",
      "type": "number",
      "format": "percent",
      "constraints": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "key": "version",
      "label": "Phiên bản",
      "type": "number",
      "required": true
    },
    {
      "key": "ai_check",
      "label": "Kiểm tra AI (JSON)",
      "type": "text",
      "format": "richtext"
    },
    {
      "key": "clause_review",
      "label": "Rà soát điều khoản (JSON)",
      "type": "text",
      "format": "richtext"
    },
    {
      "key": "extracted",
      "label": "Bóc tách (JSON)",
      "type": "text",
      "format": "richtext"
    },
    {
      "key": "skip_reason",
      "label": "Lý do bỏ qua",
      "type": "text"
    }
  ],
  "natural_key": [],
  "display_field": "party",
  "views": [
    {
      "key": "all",
      "name": "Hợp đồng",
      "columns": [
        "order",
        "party",
        "supplier",
        "step",
        "version",
        "uploaded_by",
        "uploaded_at"
      ]
    }
  ],
  "create_form": {
    "name": "Hợp đồng",
    "schema": {
      "type": "object",
      "properties": {
        "order": {
          "x-entityField": "order",
          "type": "string",
          "format": "entity",
          "x-entity": "order"
        },
        "party": {
          "x-entityField": "party",
          "type": "string",
          "enum": [
            "customer",
            "supplier"
          ]
        },
        "supplier": {
          "x-entityField": "supplier",
          "type": "string",
          "format": "entity",
          "x-entity": "supplier"
        },
        "step": {
          "x-entityField": "step",
          "type": "string",
          "enum": [
            "draft",
            "final"
          ]
        },
        "file": {
          "x-entityField": "file",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uploaded_by": {
          "x-entityField": "uploaded_by",
          "type": "string",
          "format": "entity",
          "x-entity": "user"
        },
        "uploaded_at": {
          "x-entityField": "uploaded_at",
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "x-entityField": "source",
          "type": "string",
          "enum": [
            "upload",
            "template",
            "ai"
          ]
        },
        "value": {
          "x-entityField": "value",
          "type": "number"
        },
        "advance_percent": {
          "x-entityField": "advance_percent",
          "type": "number"
        },
        "version": {
          "x-entityField": "version",
          "type": "number"
        }
      }
    }
  },
  "access": {
    "mode": "restricted",
    "grants": [
      {
        "principal": {
          "kind": "group",
          "id": "${param:am_group}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "record_scopes": [
              {
                "kind": "parent_field",
                "field": "order",
                "parent_field": "am"
              }
            ]
          },
          {
            "operation": "list",
            "record_scopes": [
              {
                "kind": "parent_field",
                "field": "order",
                "parent_field": "am"
              }
            ]
          }
        ]
      },
      {
        "principal": {
          "kind": "group",
          "id": "${param:sa_group}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "record_scopes": [
              {
                "kind": "parent_field",
                "field": "order",
                "parent_field": "sa"
              }
            ]
          },
          {
            "operation": "list",
            "record_scopes": [
              {
                "kind": "parent_field",
                "field": "order",
                "parent_field": "sa"
              }
            ]
          },
          {
            "operation": "create",
            "record_scopes": [
              {
                "kind": "parent_field",
                "field": "order",
                "parent_field": "sa"
              }
            ]
          }
        ]
      },
      {
        "principal": {
          "kind": "group",
          "id": "${param:sd_group}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          }
        ]
      },
      {
        "principal": {
          "kind": "group",
          "id": "${param:proc_group}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          },
          {
            "operation": "create",
            "scope": "organization"
          }
        ]
      },
      {
        "principal": {
          "kind": "group",
          "id": "${param:acc_group}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          }
        ]
      },
      {
        "principal": {
          "kind": "group",
          "id": "${param:admin_group}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          }
        ]
      },
      {
        "principal": {
          "kind": "group",
          "id": "${param:automation_group}"
        },
        "design": false,
        "operations": [
          {
            "operation": "read",
            "scope": "organization"
          },
          {
            "operation": "list",
            "scope": "organization"
          },
          {
            "operation": "create",
            "scope": "organization"
          },
          {
            "operation": "update",
            "scope": "organization"
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "key": "only_ai_fields_change",
      "message": "Hợp đồng đã tải lên không sửa được — hãy tải phiên bản mới",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "order",
                "party",
                "supplier",
                "step",
                "file",
                "uploaded_by",
                "uploaded_at",
                "source",
                "value",
                "advance_percent",
                "version"
              ]
            }
          }
        ]
      }
    },
    {
      "key": "customer_by_sa",
      "message": "Chỉ Sales Admin tải hợp đồng khách hàng",
      "field": "party",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "party",
              "op": "eq",
              "value": "customer"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:sa_group}"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:automation_group}"
              }
            }
          }
        ]
      }
    },
    {
      "key": "supplier_by_proc",
      "message": "Chỉ Mua hàng tải hợp đồng nhà cung cấp",
      "field": "party",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "party",
              "op": "eq",
              "value": "supplier"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:proc_group}"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:automation_group}"
              }
            }
          }
        ]
      }
    },
    {
      "key": "supplier_needs_supplier",
      "message": "Hợp đồng nhà cung cấp phải chọn nhà cung cấp",
      "field": "supplier",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "party",
              "op": "eq",
              "value": "supplier"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "supplier",
              "op": "is_empty"
            }
          }
        ]
      }
    },
    {
      "key": "closed_order_takes_no_contract",
      "message": "Đơn đã đóng — không tải thêm hợp đồng",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "order.status",
              "op": "in",
              "value": [
                "done",
                "close_lost"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:automation_group}"
              }
            }
          }
        ]
      }
    }
  ],
  "conversation": null
}
