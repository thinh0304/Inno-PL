  "rules": [
    {
      "key": "holder_changes_only_outcome",
      "message": "Người làm task chỉ chọn kết quả và nhập lý do",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "order",
                "task_code",
                "stage",
                "role",
                "am_user",
                "opened_at",
                "due_at",
                "finished_at",
                "sla_days",
                "due_state",
                "late_days",
                "priority"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:automation_group}"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:admin_group}"
              }
            }
          }
        ]
      }
    },
    {
      "key": "returned_only_t22_t31",
      "message": "Chỉ task duyệt giải pháp (t22) và phê duyệt đơn (t31) được trả lại",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "outcome",
              "op": "eq",
              "value": "returned"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "task_code",
              "op": "ne",
              "value": "t22"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "task_code",
              "op": "ne",
              "value": "t31"
            }
          }
        ]
      },
      "field": "outcome"
    },
    {
      "key": "revise_only_t42",
      "message": "Chỉ task duyệt dự thảo hợp đồng (t42) được đồng ý hoặc yêu cầu sửa",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "outcome",
              "op": "in",
              "value": [
                "agreed",
                "revise"
              ]
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "task_code",
              "op": "ne",
              "value": "t42"
            }
          }
        ]
      },
      "field": "outcome"
    },
    {
      "key": "submitted_only_t11",
      "message": "Chỉ task lập đơn (t11) được gửi duyệt",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "outcome",
              "op": "eq",
              "value": "submitted"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "task_code",
              "op": "ne",
              "value": "t11"
            }
          }
        ]
      },
      "field": "outcome"
    },
    {
      "key": "not_applicable_only_t53",
      "message": "Chỉ task thanh toán tạm ứng NCC (t53) được đánh dấu không áp dụng",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "status"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "status",
              "op": "eq",
              "value": "not_applicable"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "task_code",
              "op": "ne",
              "value": "t53"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:automation_group}"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:admin_group}"
              }
            }
          }
        ]
      },
      "field": "status"
    },
    {
      "key": "auto_approved_is_automatic",
      "message": "Kết quả tự duyệt do hệ thống đặt",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "outcome",
              "op": "eq",
              "value": "auto_approved"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:automation_group}"
              }
            }
          }
        ]
      },
      "field": "outcome"
    },
    {
      "key": "reason_for_return",
      "message": "Trả lại hoặc yêu cầu sửa phải có lý do",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "outcome",
              "op": "in",
              "value": [
                "returned",
                "revise"
              ]
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "reason",
              "op": "is_empty"
            }
          }
        ]
      },
      "field": "reason"
    },
