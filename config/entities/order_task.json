    },
    {
      "key": "am_user",
      "label": "AM của đơn",
      "type": "reference",
      "target_entity_id": "ffffffff-0000-0000-0000-000000000001"
    },
    {
      "key": "status",
      "label": "Trạng thái",
      "type": "enum",
      "facetable": true,
      "enum_values": [
        {
          "value": "blocked",
          "label": "Chưa tới lượt",
          "color": "gray"
        },
        {
          "value": "open",
          "label": "Đang chờ làm",
          "color": "sky"
        },
        {
          "value": "done",
          "label": "Đã xong",
          "color": "emerald"
        },
        {
          "value": "skipped",
          "label": "Tự duyệt",
          "color": "teal"
        },
        {
          "value": "not_applicable",
          "label": "Không áp dụng",
          "color": "slate"
        },
        {
          "value": "cancelled",
          "label": "Đã hủy",
          "color": "rose"
        }
      ],
      "default": {
        "kind": "literal",
        "value": "blocked"
      }
    },
    {
      "key": "outcome",
      "label": "Kết quả",
      "type": "enum",
      "facetable": true,
      "enum_values": [
        {
          "value": "submitted",
          "label": "Đã gửi duyệt"
        },
        {
          "value": "approved",
          "label": "Duyệt"
        },
        {
          "value": "returned",
          "label": "Trả lại"
        },
        {
          "value": "agreed",
          "label": "Đồng ý"
        },
        {
          "value": "revise",
          "label": "Yêu cầu sửa dự thảo"
        },
        {
          "value": "completed",
          "label": "Hoàn thành"
        },
        {
          "value": "not_applicable",
          "label": "Không áp dụng"
        },
        {
          "value": "auto_approved",
          "label": "Tự duyệt"
        }
      ]
    },
    {
      "key": "reason",
      "label": "Lý do",
      "type": "text"
    },
    {
      "key": "opened_at",
      "label": "Mở lúc",
      "type": "datetime"
    },
    {
      "key": "due_at",
      "label": "Hạn",
      "type": "datetime"
    },
    {
      "key": "finished_at",
      "label": "Xong lúc",
      "type": "datetime"
    },
    {
      "key": "sla_days",
      "label": "SLA (ngày làm việc)",
      "type": "number"
    },
    {
      "key": "due_state",
      "label": "Tình trạng hạn",
      "type": "enum",
      "facetable": true,
      "enum_values": [
        {
          "value": "on_time",
          "label": "Còn hạn"
        },
        {
          "value": "due_soon",
          "label": "Sắp đến hạn"
        },
        {
          "value": "overdue",
          "label": "Quá hạn"
        },
        {
          "value": "done_on_time",
          "label": "Xong đúng hạn"
        },
        {
          "value": "done_late",
          "label": "Xong trễ"
        }
      ]
    },
    {
      "key": "late_days",
      "label": "Số ngày trễ",
      "type": "number"
    },
    {
      "key": "priority",
      "label": "Mức ưu tiên",
      "type": "enum",
      "enum_values": [
        {
          "value": "normal",
          "label": "Bình thường"
        }
      ],
      "default": {
        "kind": "literal",
        "value": "normal"
      }
    }
  ],
  "natural_key": [
