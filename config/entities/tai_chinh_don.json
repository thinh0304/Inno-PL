              "field": "don_hang.trang_thai",
              "op": "not_in",
              "value": [
                "nhap",
                "tra_lai"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
