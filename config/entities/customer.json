{
  "key": "customer",
  "name": "Khách hàng",
  "description": "Hồ sơ khách hàng dùng lại giữa các đơn (FR-1.6a–c); mỗi đơn vẫn lưu bản sao thông tin tại thời điểm lập.",
  "icon": "building",
  "accent": "sky",
  "fields": [
