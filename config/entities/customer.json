    {"key":"name","label":"Tên khách hàng","type":"text","required":true,"searchable":true},
    {"key":"tax_code","label":"Mã số thuế","type":"text","searchable":true,"constraints":{"pattern":"^\\d{10}(-\\d{3})?$"}},
    {"key":"address","label":"Địa chỉ","type":"text"},
    {"key":"tier","label":"Hạng khách hàng","type":"enum","facetable":true,"enum_values":[{"value":"vip","label":"VIP","color":"violet"},{"value":"potential","label":"Tiềm năng","color":"sky"},{"value":"standard","label":"Phổ thông","color":"gray"}],"default":{"kind":"literal","value":"standard"}},
    {"key":"representative","label":"Người đại diện","type":"text"},
    {"key":"representative_title","label":"Chức vụ người đại diện","type":"text"},
    {"key":"bank_account","label":"Số tài khoản","type":"text"},
    {"key":"bank_name","label":"Ngân hàng","type":"text"},
    {"key":"contacts","label":"Người liên hệ","type":"list","sortable":false,"item_fields":[{"key":"name","label":"Họ tên","type":"text","required":true},{"key":"phone","label":"Số điện thoại","type":"text","required":false},{"key":"email","label":"Email","type":"text","required":false}]},
    {"key":"receiver_name","label":"Người nhận hàng (lần trước)","type":"text"},
    {"key":"receiver_phone","label":"SĐT người nhận (lần trước)","type":"text"},
    {"key":"delivery_address","label":"Địa chỉ giao hàng (lần trước)","type":"text"},
    {"key":"delivery_note","label":"Ghi chú giao hàng","type":"text"},
    {"key":"tax_lookup","label":"Kết quả tra cứu MST gần nhất","type":"text","format":"richtext"},
    {"key":"tax_status","label":"Tình trạng MST","type":"text"}
  ],
  "natural_key": [{"id":"by_code","name":"Mã khách hàng","fields":["code"]},{"id":"by_tax","name":"Mã số thuế","fields":["tax_code"]}],
  "display_field": "name",
  "views": [
    {"key":"all","name":"Khách hàng","columns":["code","name","tax_code","tier","representative"]}
  ],
  "create_form": {"name":"Khách hàng","schema":{"type":"object","properties":{"code":{"x-entityField":"code","type":"string"},"name":{"x-entityField":"name","type":"string"},"tax_code":{"x-entityField":"tax_code","type":"string"},"address":{"x-entityField":"address","type":"string"},"tier":{"x-entityField":"tier","type":"string","enum":["vip","potential","standard"]},"representative":{"x-entityField":"representative","type":"string"},"representative_title":{"x-entityField":"representative_title","type":"string"},"bank_account":{"x-entityField":"bank_account","type":"string"},"bank_name":{"x-entityField":"bank_name","type":"string"},"receiver_name":{"x-entityField":"receiver_name","type":"string"},"receiver_phone":{"x-entityField":"receiver_phone","type":"string"},"delivery_address":{"x-entityField":"delivery_address","type":"string"},"delivery_note":{"x-entityField":"delivery_note","type":"string"},"tax_lookup":{"x-entityField":"tax_lookup","type":"string"},"tax_status":{"x-entityField":"tax_status","type":"string"}}}},
