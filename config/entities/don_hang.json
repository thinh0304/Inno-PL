  "rules": [
    {
      "key": "khoa_khi_da_gui",
      "message": "Đơn đã gửi duyệt: chỉ sửa được khi đơn đang nháp hoặc bị trả lại",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "was",
              "rule": {
                "field": "trang_thai",
                "op": "not_in",
                "value": [
                  "nhap",
                  "tra_lai"
                ]
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:nhom_tu_dong}"
              }
            }
          }
        ]
      }
    },
    {
      "key": "chi_he_thong_doi_trang_thai",
      "message": "Trạng thái, giai đoạn và nhóm xem của đơn do hệ thống ghi",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "trang_thai",
                "giai_doan",
                "co_dich_vu",
                "co_hang_hoa",
