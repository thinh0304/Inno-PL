  "rules": [
    {
      "key": "nguoi_chi_tao_t11",
      "message": "Chỉ tạo được task Lập đơn (t11) hoặc yêu cầu Close-lost / Xin duyệt lại; các task khác do hệ thống mở",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "ma",
              "op": "not_in",
              "value": [
                "t11",
                "yc_close_lost",
                "yc_xin_duyet_lai"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "${param:nhom_tu_dong}"
              }
            }
          }
        ]
      }
    },
    {
