{
  "workflow": "@obj:workflow:request_pl_on_proposal_update",
  "kind": "entity_record",
  "enabled": false,
  "config": {
    "entity_id": "@obj:entity:purchase_proposal",
    "change_kind": "updated",
    "input_mappings": [],
    "filter": {
      "or": [
        {
          "in": [
            "proposed_cost",
            {
              "var": "event.changed"
            }
          ]
        },
        {
          "in": [
            "actual_cost",
            {
              "var": "event.changed"
            }
          ]
        }
      ]
    }
  }
}
