  "work": {
    "lifecycle": {
      "status_field": "status",
      "categories": {
        "blocked": "none",
        "open": "active",
        "done": "done",
        "skipped": "done",
        "not_applicable": "done",
        "cancelled": "cancelled"
      }
    },
    "assignable": {
      "claim": "candidates",
      "rules": [
        {
          "on": {
            "enter": [
              "open"
            ]
          },
          "when": {
            "==": [
              {
                "var": "role"
              },
              "am"
            ]
          },
          "assign": [
            {
              "kind": "dynamic",
              "source": {
                "type": "field",
                "key": "am_user"
              },
              "relation": {
                "type": "direct"
              },
              "fallback": [
                {
                  "kind": "group",
                  "id": "@param:am_group"
                }
              ]
            }
          ]
        },
        {
          "on": {
            "enter": [
              "open"
            ]
          },
          "when": {
            "==": [
              {
                "var": "role"
              },
              "sa"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:sa_group"
            }
          ]
        },
        {
          "on": {
            "enter": [
              "open"
            ]
          },
          "when": {
            "==": [
              {
                "var": "role"
              },
              "tm"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:tm_group"
            }
          ]
        },
        {
          "on": {
            "enter": [
              "open"
            ]
          },
          "when": {
            "==": [
              {
                "var": "role"
              },
              "sd"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:sd_group"
            }
          ]
        },
        {
          "on": {
            "enter": [
              "open"
            ]
          },
          "when": {
            "==": [
              {
                "var": "role"
              },
              "proc"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:proc_group"
            }
          ]
        },
        {
          "on": {
            "enter": [
              "open"
            ]
          },
          "when": {
            "==": [
              {
                "var": "role"
              },
              "acc"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:acc_group"
            }
          ]
        }
      ]
    },
    "work_surface": {
      "priority": {
        "field": "priority",
        "values": {
          "normal": "normal"
        }
      }
    },
    "module_page": "/tasks/{{ record_id }}"
  }
}
