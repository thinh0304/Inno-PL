  "stage_model": {
    "status_field": "status",
    "initial_statuses": [
      "blocked",
      "open",
      "not_applicable"
    ],
    "transitions": [
      {
        "from": "blocked",
        "to": "open",
        "movers": [
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      },
      {
        "from": "blocked",
        "to": "skipped",
        "movers": [
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      },
      {
        "from": "blocked",
        "to": "not_applicable",
        "movers": [
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      },
      {
        "from": "blocked",
        "to": "cancelled",
        "movers": [
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      },
      {
        "from": "open",
        "to": "blocked",
        "movers": [
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
