{
  "name": "Đề xuất mua",
  "description": "Giá mua và NCC Mua hàng đề xuất cho dòng hàng hóa (t23), giá mua thực tế. Chỉ Mua hàng, SD, Kế toán xem (FR-4.6).",
  "icon": "cart",
  "accent": "amber",
  "access": "restricted",
  "fields": [
    "@obj:entity_field:purchase_proposal/order_line",
    "@obj:entity_field:purchase_proposal/order",
    "@obj:entity_field:purchase_proposal/proposed_cost",
    "@obj:entity_field:purchase_proposal/actual_cost",
    "@obj:entity_field:purchase_proposal/proposed_supplier",
    "@obj:entity_field:purchase_proposal/note"
  ],
  "natural_key": [
    {
      "id": "by_line",
      "name": "Dòng danh mục",
      "fields": [
        "order_line"
      ]
    }
  ],
  "display_field": "proposed_cost",
  "create_form": "@obj:form:purchase_proposal",
  "rules": [
    {
      "key": "order_is_fixed",
      "message": "Không chuyển được sang đơn khác",
      "field": "order",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "order"
            }
          }
        ]
      }
    },
    {
      "key": "order_line_is_fixed",
      "message": "Không chuyển được sang dòng khác",
      "field": "order_line",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "order_line"
            }
          }
        ]
      }
    },
    {
      "key": "line_belongs_to_order",
      "message": "Dòng danh mục không thuộc đơn này",
      "field": "order_line",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "order_line.order",
              "op": "ne",
              "value": {
                "$field": "order"
              }
            }
          }
        ]
      }
    }
  ]
}
