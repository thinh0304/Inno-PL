{
  "name": "Đơn hàng",
  "description": "Đơn bán hàng: khách hàng, giao nhận, phiếu khảo sát phần không có tiền, người phụ trách (Thiết kế 6.2). Không chứa số tiền.",
  "icon": "receipt",
  "accent": "sky",
  "access": "restricted",
  "fields": [
    "@obj:entity_field:order/number",
    "@obj:entity_field:order/code",
    "@obj:entity_field:order/status",
    "@obj:entity_field:order/stage",
    "@obj:entity_field:order/customer",
    "@obj:entity_field:order/customer_name",
    "@obj:entity_field:order/customer_code",
    "@obj:entity_field:order/tax_code",
    "@obj:entity_field:order/address",
    "@obj:entity_field:order/contact_name",
    "@obj:entity_field:order/contact_phone",
    "@obj:entity_field:order/contact_email",
    "@obj:entity_field:order/representative",
    "@obj:entity_field:order/representative_title",
    "@obj:entity_field:order/bank_account",
    "@obj:entity_field:order/bank_name",
    "@obj:entity_field:order/receiver_name",
    "@obj:entity_field:order/receiver_phone",
    "@obj:entity_field:order/delivery_address",
    "@obj:entity_field:order/delivery_note",
    "@obj:entity_field:order/quote_date",
    "@obj:entity_field:order/quote_valid_until",
    "@obj:entity_field:order/exchange_rate",
    "@obj:entity_field:order/internal_contract_no",
    "@obj:entity_field:order/customer_po_no",
    "@obj:entity_field:order/content",
    "@obj:entity_field:order/signed_on",
    "@obj:entity_field:order/am",
    "@obj:entity_field:order/sa",
    "@obj:entity_field:order/inside_sales",
    "@obj:entity_field:order/is_new_order",
    "@obj:entity_field:order/is_new_logo",
    "@obj:entity_field:order/prev_contract_no",
    "@obj:entity_field:order/lead_source",
    "@obj:entity_field:order/customer_tier",
    "@obj:entity_field:order/debt_days",
    "@obj:entity_field:order/use_provision_fund",
    "@obj:entity_field:order/payment_count",
    "@obj:entity_field:order/customer_prepays",
    "@obj:entity_field:order/deploy_staff",
    "@obj:entity_field:order/consult_staff",
    "@obj:entity_field:order/proposal",
    "@obj:entity_field:order/poc",
    "@obj:entity_field:order/contract_type_override",
    "@obj:entity_field:order/deal_stages",
    "@obj:entity_field:order/has_goods",
    "@obj:entity_field:order/has_service",
    "@obj:entity_field:order/pl_requested_at",
    "@obj:entity_field:order/approved",
    "@obj:entity_field:order/approved_at",
    "@obj:entity_field:order/contract_signed",
    "@obj:entity_field:order/pending_roles",
    "@obj:entity_field:order/close_reason"
  ],
  "natural_key": [],
  "display_field": "code",
  "create_form": "@obj:form:order",
  "rules": [
    {
      "key": "locked_after_submit",
      "message": "Đơn đã gửi duyệt — không sửa được",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "was",
              "rule": {
                "field": "status",
                "op": "ne",
                "value": "draft"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "customer",
                "customer_name",
                "customer_code",
                "tax_code",
                "address",
                "contact_name",
                "contact_phone",
                "contact_email",
                "representative",
                "representative_title",
                "bank_account",
                "bank_name",
                "receiver_name",
                "receiver_phone",
                "delivery_address",
                "delivery_note",
                "quote_date",
                "quote_valid_until",
                "exchange_rate",
                "internal_contract_no",
                "customer_po_no",
                "content",
                "signed_on",
                "am",
                "sa",
                "inside_sales",
                "is_new_order",
                "is_new_logo",
                "prev_contract_no",
                "lead_source",
                "customer_tier",
                "debt_days",
                "use_provision_fund",
                "payment_count",
                "customer_prepays",
                "deploy_staff",
                "consult_staff",
                "proposal",
                "poc",
                "contract_type_override",
                "deal_stages",
                "pl_requested_at"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:admin_group"
              }
            }
          }
        ]
      }
    },
    {
      "key": "flow_fields_are_automatic",
      "message": "Giai đoạn, phê duyệt và việc đang chờ do hệ thống đặt",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "stage",
                "approved",
                "approved_at",
                "contract_signed",
                "pending_roles"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:admin_group"
              }
            }
          }
        ]
      }
    },
    {
      "key": "new_order_is_unapproved",
      "message": "Đơn mới chưa được phê duyệt",
      "field": "approved",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "approved",
              "op": "eq",
              "value": true
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:admin_group"
              }
            }
          }
        ]
      }
    },
    {
      "key": "new_order_is_draft",
      "message": "Đơn mới bắt đầu ở trạng thái nháp",
      "field": "status",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "status",
              "op": "ne",
              "value": "draft"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:admin_group"
              }
            }
          }
        ]
      }
    },
    {
      "key": "close_lost_before_contract",
      "message": "Đã ký HĐ khách hàng — không Close-lost được",
      "field": "status",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "status"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "status",
              "op": "eq",
              "value": "close_lost"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "contract_signed",
              "op": "eq",
              "value": true
            }
          }
        ]
      }
    },
    {
      "key": "am_is_fixed",
      "message": "Chỉ Quản trị viên đổi được AM phụ trách của đơn",
      "field": "am",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "am"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:admin_group"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          }
        ]
      }
    }
  ],
  "stage_model": {
    "status_field": "status",
    "initial_statuses": [
      "draft"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "in_progress",
        "movers": [
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      },
      {
        "from": "in_progress",
        "to": "draft",
        "movers": [
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      },
      {
        "from": "in_progress",
        "to": "done",
        "movers": [
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      },
      {
        "from": "draft",
        "to": "close_lost",
        "required_fields": [
          "close_reason"
        ],
        "movers": [
          {
            "kind": "in_field",
            "field": "am"
          },
          {
            "kind": "in_field",
            "field": "sa"
          },
          {
            "kind": "in_group",
            "group_id": "@param:admin_group"
          },
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      },
      {
        "from": "in_progress",
        "to": "close_lost",
        "required_fields": [
          "close_reason"
        ],
        "movers": [
          {
            "kind": "in_field",
            "field": "am"
          },
          {
            "kind": "in_field",
            "field": "sa"
          },
          {
            "kind": "in_group",
            "group_id": "@param:admin_group"
          },
          {
            "kind": "in_group",
            "group_id": "@param:automation_group"
          }
        ]
      }
    ]
  }
}
