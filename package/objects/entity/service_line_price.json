{
  "name": "Giá dòng dịch vụ",
  "description": "Giá bán, chiết khấu, VAT, giá mua dự kiến của Sale và NCC cho dòng dịch vụ. Kỹ thuật đọc được, Mua hàng không.",
  "icon": "tags",
  "accent": "amber",
  "access": "restricted",
  "fields": [
    "@obj:entity_field:service_line_price/order_line",
    "@obj:entity_field:service_line_price/order",
    "@obj:entity_field:service_line_price/unit_price",
    "@obj:entity_field:service_line_price/discount_pct",
    "@obj:entity_field:service_line_price/vat_rate",
    "@obj:entity_field:service_line_price/unit_cost",
    "@obj:entity_field:service_line_price/supplier"
  ],
  "natural_key": [
    {
      "id": "by_line",
      "name": "Dòng danh mục",
      "fields": [
        "order_line"
      ]
    }
  ],
  "display_field": "unit_price",
  "create_form": "@obj:form:service_line_price",
  "rules": [
    {
      "key": "order_is_fixed",
      "message": "Không chuyển được sang đơn khác",
      "field": "order",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "order"
            }
          }
        ]
      }
    },
    {
      "key": "order_line_is_fixed",
      "message": "Không chuyển được sang dòng khác",
      "field": "order_line",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "order_line"
            }
          }
        ]
      }
    },
    {
      "key": "line_belongs_to_order",
      "message": "Dòng danh mục không thuộc đơn này",
      "field": "order_line",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "order_line.order",
              "op": "ne",
              "value": {
                "$field": "order"
              }
            }
          }
        ]
      }
    }
  ]
}
