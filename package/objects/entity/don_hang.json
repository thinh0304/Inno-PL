    "@obj:entity_field:don_hang/chuc_vu",
    "@obj:entity_field:don_hang/so_tk",
    "@obj:entity_field:don_hang/ngan_hang",
    "@obj:entity_field:don_hang/so_hd_po",
    "@obj:entity_field:don_hang/ngay_ky",
