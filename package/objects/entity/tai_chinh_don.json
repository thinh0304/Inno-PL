            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "pl_chot",
                "cau_hinh_chot",
                "ln_thuan_chot",
                "dat_chot",
                "chot_luc"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
