                "cpbh",
                "so_hd_truoc",
                "cpbh_truoc",
                "doanh_thu_truoc",
                "ln_truoc"
              ]
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "don_hang.trang_thai",
              "op": "not_in",
              "value": [
                "nhap",
                "tra_lai"
              ]
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "don_hang.cho_duyet_lai",
              "op": "eq",
              "value": false
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
