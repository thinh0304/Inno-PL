{
  "name": "Task",
  "description": "Một việc của quy trình đơn hàng, giao cho một vai trò.",
  "icon": "list-checks",
  "accent": "violet",
  "access": "restricted",
  "fields": [
    "@obj:entity_field:task/don_hang",
    "@obj:entity_field:task/ma",
    "@obj:entity_field:task/vai_tro",
    "@obj:entity_field:task/trang_thai",
    "@obj:entity_field:task/uu_tien",
    "@obj:entity_field:task/am",
    "@obj:entity_field:task/is",
    "@obj:entity_field:task/nhom",
    "@obj:entity_field:task/han",
    "@obj:entity_field:task/ly_do",
    "@obj:entity_field:task/nguoi_tao"
  ],
  "natural_key": [],
  "display_field": "ma",
  "create_form": "@obj:form:task",
  "rules": [
    {
      "key": "nguoi_chi_tao_t11",
      "message": "Chỉ tạo được task Lập đơn (t11) hoặc yêu cầu Close-lost / Xin duyệt lại; các task khác do hệ thống mở",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "ma",
              "op": "not_in",
              "value": [
                "t11",
                "yc_close_lost",
                "yc_xin_duyet_lai"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
          }
        ]
      }
    },
    {
      "key": "chi_nguoi_giu_doi_trang_thai",
      "message": "Chỉ người đang giữ task mới đổi được trạng thái",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "trang_thai"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "is_holder"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
          }
        ]
      }
    },
    {
      "key": "khoa_danh_tinh_task",
      "message": "Không đổi được mã, vai trò, đơn hay người được giao của task: do hệ thống ghi",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "ma",
                "vai_tro",
                "don_hang",
                "nhom",
                "am",
                "is",
                "han",
                "nguoi_tao"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
          }
        ]
      }
    },
    {
      "key": "chi_tao_dang_lam",
      "message": "Task mới chỉ được tạo ở trạng thái Đang làm",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "trang_thai",
              "op": "ne",
              "value": "dang_lam"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
          }
        ]
      }
    },
    {
      "key": "chi_t22_t31_tra_lai",
      "message": "Chỉ task Duyệt kỹ thuật (t22) và Phê duyệt đơn (t31) mới được Trả lại",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "trang_thai"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "trang_thai",
              "op": "eq",
              "value": "tra_lai"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "ma",
              "op": "not_in",
              "value": [
                "t22",
                "t31"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
          }
        ]
      }
    },
    {
      "key": "chi_t42_yeu_cau_sua",
      "message": "Chỉ task Duyệt dự thảo (t42) mới được Yêu cầu sửa",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "trang_thai"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "trang_thai",
              "op": "eq",
              "value": "yeu_cau_sua"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "ma",
              "op": "ne",
              "value": "t42"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
          }
        ]
      }
    }
  ],
