{
  "name": "Task",
  "description": "Một việc của quy trình đơn hàng, giao cho một vai trò.",
  "icon": "list-checks",
  "accent": "violet",
  "access": "restricted",
  "fields": [
    "@obj:entity_field:task/don_hang",
    "@obj:entity_field:task/ma",
    "@obj:entity_field:task/vai_tro",
    "@obj:entity_field:task/trang_thai",
    "@obj:entity_field:task/uu_tien",
    "@obj:entity_field:task/am",
    "@obj:entity_field:task/is",
    "@obj:entity_field:task/nhom",
    "@obj:entity_field:task/han",
    "@obj:entity_field:task/ly_do"
  ],
  "natural_key": [],
  "display_field": "ma",
  "create_form": "@obj:form:task",
  "rules": [
    {
      "key": "nguoi_chi_tao_t11",
      "message": "Chỉ tạo được task Lập đơn (t11); các task khác do hệ thống mở",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "ma",
              "op": "ne",
              "value": "t11"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
          }
        ]
      }
    },
    {
      "key": "chi_nguoi_giu_doi_trang_thai",
      "message": "Chỉ người đang giữ task mới đổi được trạng thái",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed",
              "field": "trang_thai"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "is_holder"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:nhom_tu_dong"
              }
            }
          }
        ]
      }
    }
  ],
  "work": {
    "lifecycle": {
      "status_field": "trang_thai",
      "categories": {
        "cho": "waiting",
        "dang_lam": "active",
        "xong": "done",
        "khong_ap_dung": "done",
        "bo_qua": "done",
        "tra_lai": "done",
        "huy": "cancelled"
      }
    },
    "assignable": {
      "claim": "candidates",
      "rules": [
        {
          "on": "start",
          "when": {
            "==": [
              {
                "var": "vai_tro"
              },
              "am"
            ]
          },
          "assign": [
            {
              "kind": "dynamic",
              "source": {
                "type": "field",
                "key": "am"
              }
            }
          ]
        },
        {
          "on": "start",
          "when": {
            "==": [
              {
                "var": "vai_tro"
              },
              "is"
            ]
          },
          "assign": [
            {
              "kind": "dynamic",
              "source": {
                "type": "field",
                "key": "is"
              }
            }
          ]
        },
        {
          "on": "start",
          "when": {
            "==": [
              {
                "var": "vai_tro"
              },
              "tm"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:nhom_tm"
            }
          ]
        },
        {
          "on": "start",
          "when": {
            "==": [
              {
                "var": "vai_tro"
              },
              "proc"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:nhom_proc"
            }
          ]
        },
        {
          "on": "start",
          "when": {
            "==": [
              {
                "var": "vai_tro"
              },
              "sd"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:nhom_sd"
            }
          ]
        },
        {
          "on": "start",
          "when": {
            "==": [
              {
                "var": "vai_tro"
              },
              "acc"
            ]
          },
          "assign": [
            {
              "kind": "group",
              "id": "@param:nhom_acc"
            }
          ]
        }
      ]
    },
    "work_surface": {
      "priority": {
        "field": "uu_tien",
        "values": {
          "binh_thuong": "normal",
          "cao": "high"
        }
      }
    },
    "module_page": "/don/{{ record_id }}"
  }
}
