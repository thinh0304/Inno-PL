{
  "name": "Hợp đồng",
  "description": "Hợp đồng của đơn: khách hàng và từng nhà cung cấp, bản dự thảo và bản chính thức (FR-7.1). Mỗi lần tải lên là một phiên bản mới; không ai sửa hay xóa.",
  "icon": "file",
  "accent": "slate",
  "access": "restricted",
  "fields": [
    "@obj:entity_field:contract/order",
    "@obj:entity_field:contract/party",
    "@obj:entity_field:contract/supplier",
    "@obj:entity_field:contract/step",
    "@obj:entity_field:contract/file",
    "@obj:entity_field:contract/uploaded_by",
    "@obj:entity_field:contract/uploaded_at",
    "@obj:entity_field:contract/source",
    "@obj:entity_field:contract/value",
    "@obj:entity_field:contract/advance_percent",
    "@obj:entity_field:contract/version",
    "@obj:entity_field:contract/ai_check",
    "@obj:entity_field:contract/clause_review",
    "@obj:entity_field:contract/extracted",
    "@obj:entity_field:contract/skip_reason"
  ],
  "natural_key": [],
  "display_field": "party",
  "create_form": "@obj:form:contract",
  "rules": [
    {
      "key": "only_ai_fields_change",
      "message": "Hợp đồng đã tải lên không sửa được — hãy tải phiên bản mới",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_update"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "changed_any",
              "fields": [
                "order",
                "party",
                "supplier",
                "step",
                "file",
                "uploaded_by",
                "uploaded_at",
                "source",
                "value",
                "advance_percent",
                "version"
              ]
            }
          }
        ]
      }
    },
    {
      "key": "customer_by_sa",
      "message": "Chỉ Sales Admin tải hợp đồng khách hàng",
      "field": "party",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "party",
              "op": "eq",
              "value": "customer"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:sa_group"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          }
        ]
      }
    },
    {
      "key": "supplier_by_proc",
      "message": "Chỉ Mua hàng tải hợp đồng nhà cung cấp",
      "field": "party",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "party",
              "op": "eq",
              "value": "supplier"
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:proc_group"
              }
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          }
        ]
      }
    },
    {
      "key": "supplier_needs_supplier",
      "message": "Hợp đồng nhà cung cấp phải chọn nhà cung cấp",
      "field": "supplier",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "field",
            "rule": {
              "field": "party",
              "op": "eq",
              "value": "supplier"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "supplier",
              "op": "is_empty"
            }
          }
        ]
      }
    },
    {
      "key": "closed_order_takes_no_contract",
      "message": "Đơn đã đóng — không tải thêm hợp đồng",
      "condition": {
        "join": "and",
        "leaves": [
          {
            "kind": "write",
            "write": {
              "op": "is_new"
            }
          },
          {
            "kind": "field",
            "rule": {
              "field": "order.status",
              "op": "in",
              "value": [
                "done",
                "close_lost"
              ]
            }
          },
          {
            "kind": "write",
            "write": {
              "op": "actor",
              "negate": true,
              "test": {
                "kind": "in_group",
                "group_id": "@param:automation_group"
              }
            }
          }
        ]
      }
    }
  ]
}
