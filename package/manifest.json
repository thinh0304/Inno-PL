  "parameters": [
    {
      "key": "app_users",
      "type": "group_ref",
      "required": true,
      "label": "Người dùng PL",
      "help": "Nhóm chứa mọi người dùng ứng dụng thuộc 7 vai trò (AM, Sales Admin, Technical Manager, Sales Director, Mua hàng, Kế toán bán hàng, Quản trị viên PL). Ai không ở nhóm này sẽ không thấy ứng dụng, kể cả khi đã ở nhóm vai trò. Thành viên cần một role có entity.read, entity.list và entity.write: role không đến từ nhóm."
    },
    {
      "key": "am_group",
      "type": "group_ref",
      "required": true,
      "label": "AM · Nhân viên Sale",
      "help": "Nhân viên kinh doanh (AM) lập đơn, nhập phiếu khảo sát, danh mục, giá bán và gửi duyệt. Thành viên cũng phải ở nhóm \"Người dùng PL\" và cần một role có entity.read, entity.list và entity.write. Chọn một nhóm khác với nhóm \"Người dùng PL\" và các nhóm vai trò khác (nền tảng không cho một nhóm nhận hai bộ quyền trên cùng entity); thành viên được trùng nhau."
    },
    {
      "key": "sa_group",
      "type": "group_ref",
      "required": true,
      "label": "Sales Admin",
      "help": "Sales Admin hỗ trợ Sale lập đơn, soạn và theo dõi hợp đồng với khách hàng. Thành viên cũng phải ở nhóm \"Người dùng PL\" và cần một role có entity.read, entity.list và entity.write. Chọn một nhóm khác với nhóm \"Người dùng PL\" và các nhóm vai trò khác (nền tảng không cho một nhóm nhận hai bộ quyền trên cùng entity); thành viên được trùng nhau."
    },
    {
      "key": "tm_group",
      "type": "group_ref",
      "required": true,
      "label": "Technical Manager",
      "help": "Trưởng bộ phận kỹ thuật: xem thông số, báo giá mua dịch vụ và xác nhận triển khai. Thành viên cũng phải ở nhóm \"Người dùng PL\" và cần một role có entity.read, entity.list và entity.write. Chọn một nhóm khác với nhóm \"Người dùng PL\" và các nhóm vai trò khác (nền tảng không cho một nhóm nhận hai bộ quyền trên cùng entity); thành viên được trùng nhau."
    },
    {
      "key": "sd_group",
      "type": "group_ref",
      "required": true,
      "label": "Sales Director",
      "help": "Giám đốc kinh doanh: phê duyệt P&L và đồng ý trình ký. Thành viên cũng phải ở nhóm \"Người dùng PL\" và cần một role có entity.read, entity.list và entity.write. Chọn một nhóm khác với nhóm \"Người dùng PL\" và các nhóm vai trò khác (nền tảng không cho một nhóm nhận hai bộ quyền trên cùng entity); thành viên được trùng nhau."
    },
    {
      "key": "proc_group",
      "type": "group_ref",
      "required": true,
      "label": "Mua hàng",
      "help": "Bộ phận Mua hàng: đề xuất giá mua, nhà cung cấp và đặt hàng. Thành viên cũng phải ở nhóm \"Người dùng PL\" và cần một role có entity.read, entity.list và entity.write. Chọn một nhóm khác với nhóm \"Người dùng PL\" và các nhóm vai trò khác (nền tảng không cho một nhóm nhận hai bộ quyền trên cùng entity); thành viên được trùng nhau."
    },
    {
      "key": "acc_group",
      "type": "group_ref",
      "required": true,
      "label": "Kế toán bán hàng",
      "help": "Kế toán bán hàng: kiểm tra hợp đồng, xuất hóa đơn và đối soát thanh toán. Thành viên cũng phải ở nhóm \"Người dùng PL\" và cần một role có entity.read, entity.list và entity.write. Chọn một nhóm khác với nhóm \"Người dùng PL\" và các nhóm vai trò khác (nền tảng không cho một nhóm nhận hai bộ quyền trên cùng entity); thành viên được trùng nhau."
    },
    {
      "key": "admin_group",
      "type": "group_ref",
      "required": true,
      "label": "Quản trị viên PL",
      "help": "Quản trị viên ứng dụng: sửa cấu hình (loại hàng, tỷ lệ, VAT, SLA, kế hoạch, KPI) và danh mục nhân sự. Thành viên cũng phải ở nhóm \"Người dùng PL\" và cần một role có entity.read, entity.list và entity.write. Chọn một nhóm khác với nhóm \"Người dùng PL\" và các nhóm vai trò khác (nền tảng không cho một nhóm nhận hai bộ quyền trên cùng entity); thành viên được trùng nhau."
    },
    {
      "key": "automation_group",
      "type": "group_ref",
      "required": true,
      "label": "Tự động hóa PL",
      "help": "Nhóm chứa service principal chạy các workflow tự động (tính P&L, điều phối task, nhắc SLA) và một tài khoản riêng không bao giờ đăng nhập, không ai khác. Service principal cần role có entity.read, entity.list và entity.write. Chọn một nhóm khác với nhóm \"Người dùng PL\" và các nhóm vai trò khác (nền tảng không cho một nhóm nhận hai bộ quyền trên cùng entity); thành viên được trùng nhau."
    }
  ],
