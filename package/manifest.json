{
  "formatVersion": 1,
  "id": "inno/pl",
  "version": "0.1.0",
  "name": "TeraBox · Hiệu quả đơn hàng (P&L)",
  "summary": "Lập đơn bán, tự tính P&L, điều phối 15 task giữa các phòng ban có SLA và trợ lý AI, theo dõi KPI.",
  "publisher": {
    "name": "Innomation",
    "contact": "thinh.nguyentruong@innomation.vn",
    "support": "https://innomation.vn"
  },
  "license": "Proprietary",
  "dataHandling": {
    "purpose": "Lập và duyệt đơn bán hàng: thông tin khách hàng, nhà cung cấp, danh mục hàng hóa / dịch vụ, giá bán, giá mua, bảng P&L của đơn, hợp đồng, nhật ký xử lý và chỉ tiêu KPI của nhân viên.",
    "storage": "In the organization's AgentFlow",
    "retention": "Tối thiểu 5 năm kể từ khi đơn hoàn tất hoặc đóng, theo yêu cầu lưu trữ chứng từ kế toán; tổ chức có thể giữ lâu hơn.",
    "privacy": "https://innomation.vn",
    "recipients": []
  },
  "changelog": "Bản đầu: nền tảng cấu hình và bộ tính P&L.",
  "contentLocale": "vi",
  "minPlatformVersion": "2026.10",
