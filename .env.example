# Copy this file to .env (git ignores .env) and fill in the values.
# `pnpm af <command>`, `pnpm lint`, `pnpm deploy:app` and `pnpm sandbox` load .env before running agentflow-app.

# The address you open AgentFlow at, https:// with no path, e.g. https://agentflow.example.com
AGENTFLOW_URL=

# The CI key for lint / deploy / status (a service principal's key). Never commit it.
AGENTFLOW_TOKEN=

# For `sandbox` and `deploy --sandbox`: a key whose role holds sandbox.create (an admin grants it).
AGENTFLOW_SANDBOX_KEY=
